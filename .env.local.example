# Upstash Redis (https://console.upstash.com) — used to cache daily AI-generated
# guesstimates, the archive list, and the streak leaderboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Gemini API key (https://aistudio.google.com/apikey) — used by the
# daily-generation cron job and the scratchpad hint endpoint.
GEMINI_API_KEY=

# Shared secret checked against the `Authorization: Bearer <CRON_SECRET>`
# header on incoming Vercel Cron requests to /api/cron/generate-daily.
CRON_SECRET=
